#!/bin/sh
# Check the docs/ pages before a push, since pushing master deploys them.
# The type check proves they compile; the tests prove the model computes.
# Enable with: git config core.hooksPath githooks

set -e

repo_root=$(git rev-parse --show-toplevel)

if [ ! -d "$repo_root/docs/tools/node_modules" ]; then
  echo "pre-push: docs/tools deps missing; run 'npm --prefix docs/tools install'" >&2
  exit 1
fi

npm --prefix "$repo_root/docs/tools" run --silent check
npm --prefix "$repo_root/docs/tools" test --silent
