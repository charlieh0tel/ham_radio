{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "types": [
      "react",
      "react-dom"
    ],
    "moduleResolution": "bundler",
    "module": "ES2022",
    "allowUmdGlobalAccess": true
  },
  "include": [
    ".check/random-wire.jsx",
    ".check/sherwood.jsx",
    "globals.d.ts"
  ]
}
