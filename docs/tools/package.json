{
  "name": "ham-radio-docs-tools",
  "private": true,
  "type": "module",
  "description": "Dev-time type checking for the single-file pages in docs/.",
  "scripts": {
    "extract": "node extract.mjs ../antenna-matching.html .check/antenna-matching.jsx && node extract.mjs ../sherwood.html .check/sherwood.jsx",
    "check": "npm run extract && tsc -p tsconfig.check.json && eslint .check/antenna-matching.jsx",
    "check:all": "npm run extract && tsc -p tsconfig.all.json",
    "lint": "npm run extract && eslint .check/antenna-matching.jsx"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.6.0"
  }
}
